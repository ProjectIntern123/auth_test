<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SharePointAuthApp.ViewModels"
             x:Class="SharePointAuthApp.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             BackgroundColor="#F3F4F6"
             NavigationPage.HasBackButton="False">

    <ScrollView ContentContainerThickness="20" VerticalOptions="CenterAndExpand">
        <VerticalStackLayout Spacing="0" VerticalOptions="Center">

            <!-- Welcome Card -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 24"
                    BackgroundColor="White"
                    Padding="30,50,30,50"
                    Margin="16,24,16,24"
                    MaximumWidthRequest="450"
                    HorizontalOptions="CenterAndExpand">
                
                <VerticalStackLayout Spacing="25" HorizontalOptions="Center">
                    
                    <!-- Stylized Checkmark/Welcome Badge -->
                    <Border HeightRequest="90" 
                            WidthRequest="90" 
                            StrokeShape="RoundRectangle 45" 
                            BackgroundColor="#10B981" 
                            StrokeThickness="0" 
                            HorizontalOptions="Center" 
                            Margin="0,0,0,10">
                        <Label Text="👋" 
                               FontSize="42" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Hello World Message -->
                    <Label Text="Hello World" 
                           FontSize="28" 
                           FontAttributes="Bold" 
                           TextColor="#111827" 
                           HorizontalOptions="Center" />

                    <!-- Welcome Username -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="Welcome " 
                               FontSize="18" 
                               TextColor="#4B5563" />
                        <Label Text="{Binding Username}" 
                               FontSize="18" 
                               FontAttributes="Bold"
                               TextColor="#512BD4" />
                    </HorizontalStackLayout>

                    <!-- Divider -->
                    <BoxView HeightRequest="1" 
                             Color="#E5E7EB" 
                             HorizontalOptions="FillAndExpand" 
                             Margin="0,10,0,10" />

                    <!-- Logout Button -->
                    <Button Text="Logout" 
                            Command="{Binding LogoutCommand}" 
                            BackgroundColor="#EF4444" 
                            TextColor="White" 
                            HeightRequest="48"
                            CornerRadius="8" 
                            FontAttributes="Bold" 
                            FontSize="16"
                            WidthRequest="200"
                            IsEnabled="{Binding IsNotBusy}"
                            HorizontalOptions="Center"/>

                    <!-- Loading Indicator overlay -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}" 
                                       IsVisible="{Binding IsBusy}" 
                                       Color="#EF4444" 
                                       HeightRequest="30" 
                                       WidthRequest="30" 
                                       HorizontalOptions="Center" />
                    
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
